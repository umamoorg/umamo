{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Read|Write|Edit|Bash|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-mnt.sh"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.sh",
						"timeout": 180,
						"statusMessage": "Linting the changed Kotlin files"
					}
				]
			}
		]
	}
}