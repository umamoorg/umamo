<?xml version="1.0" encoding="utf-8"?>
<!--
  Simplified Chinese UI string catalog; the English default is in values/strings.xml.  The directory
  carries the region because the setting's tag is zh-CN, and Compose resources match language + region
  exactly first, then a region-less language directory, then the default.  Keeping the region means a
  later Traditional catalog (values-zh-rTW) falls back to English, never to these Simplified strings.
  Format-level identifiers (ParamAngleX, …) stay verbatim.  A key absent here resolves to the default
  catalog, so this file may be filled in incrementally.
-->
